# Create a Supabase project, then copy this file to .env.local and set these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-hosted aliases are also accepted. Hostinger may provide these names.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Prefer Supabase's current sb_secret_ key. Never expose it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy projects may use this instead:
# SUPABASE_SERVICE_ROLE_KEY=

# Public application URL (used by account invitations and password recovery).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (required for member invitation emails).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@leadchasers.ma

# Optional one-time bootstrap values. If passwords are omitted, the bootstrap
# command generates strong temporary passwords and prints them once.
LEADCHASERS_COOPERATIVE_NAME=LeadChasers Media Coop
LEADCHASERS_FOUNDER_INITIAL_PASSWORD=
LEADCHASERS_CFO_INITIAL_PASSWORD=
LEADCHASERS_CCO_INITIAL_PASSWORD=
